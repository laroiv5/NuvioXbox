<Page
    x:Class="NuvioXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#0D0D0D"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#0D0D0D">
        <MediaPlayerElement
            x:Name="NativePlayer"
            AreTransportControlsEnabled="False"
            Stretch="Uniform"
            Visibility="Collapsed"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Border x:Name="WebBackdrop" Background="#0D0D0D" />

        <Grid x:Name="WebContainer" Background="Transparent" />

        <StackPanel
            x:Name="LoadingOverlay"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                Foreground="#F5F5F5"
                FontSize="42"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Text="Nuvio TV" />
            <TextBlock
                Foreground="#99A1B3"
                FontSize="18"
                HorizontalAlignment="Center"
                Text="Loading Xbox experience..." />
        </StackPanel>
    </Grid>
</Page>
